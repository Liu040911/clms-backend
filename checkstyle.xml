<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Checkstyle Configuration — CLMS Harness Engineering Phase 2
  📖 See: docs/conventions/naming.md
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- 禁止 TAB 缩进（Java 代码使用 4 空格） -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
        <message key="file.containsTab" value="❌ 文件包含 TAB 字符，请使用 4 空格缩进。✅ FIX: 在 IDE 中设置 'editor.insertSpaces=true'"/>
    </module>

    <!-- 文件末尾空行 -->
    <module name="NewlineAtEndOfFile"/>

    <module name="TreeWalker">
        <!-- 命名规范 -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
            <message key="name.invalidPattern" value="❌ 常量命名不规范。✅ FIX: 使用 UPPER_SNAKE_CASE，如 MAX_RETRY_COUNT。📖 docs/conventions/naming.md"/>
        </module>
        <module name="LocalFinalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern" value="❌ 方法名不规范。✅ FIX: 使用 camelCase，如 getUserById。📖 docs/conventions/naming.md"/>
        </module>
        <module name="PackageName">
            <property name="format" value="^com\.clms(\.[a-z][a-z0-9]*)*$"/>
            <message key="name.invalidPattern" value="❌ 包名不规范。✅ FIX: 使用全小写，如 com.clms.service.impl"/>
        </module>
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern" value="❌ 类名不规范。✅ FIX: 使用 PascalCase，如 LectureServiceImpl"/>
        </module>

        <!-- import 顺序：先静态，再 java/jakarta，再第三方，再项目内 -->
        <module name="CustomImportOrder">
            <property name="customImportOrderRules"
                      value="STATIC###STANDARD_JAVA_PACKAGE###THIRD_PARTY_PACKAGE###SPECIAL_IMPORTS"/>
            <property name="specialImportsRegExp" value="^com\.clms\."/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
            <property name="separateLineBetweenGroups" value="true"/>
        </module>
        <module name="IllegalImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <!-- 每行最多 120 字符 -->
        <module name="LineLength">
            <property name="max" value="120"/>
            <property name="ignorePattern" value="^import |^package |http://|https://"/>
            <message key="maxLineLen" value="❌ 行长度超过 120 字符。✅ FIX: 换行或简化表达式"/>
        </module>

        <!-- 方法体长度 -->
        <module name="MethodLength">
            <property name="max" value="60"/>
            <property name="countEmpty" value="false"/>
            <message key="maxLen.method" value="❌ 方法体超过 60 行。✅ FIX: 拆分为多个小方法 (Single Responsibility)"/>
        </module>

        <!-- 参数数量 -->
        <module name="ParameterNumber">
            <property name="max" value="5"/>
            <message key="maxParam" value="❌ 参数超过 5 个。✅ FIX: 封装为 DTO 或 builder 模式"/>
        </module>

        <!-- 空块处理 -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="NeedBraces"/>

        <!-- 禁止 System.out.println -->
        <module name="Regexp">
            <property name="format" value="System\.(out|err)\.print(ln|f)?\(" />
            <property name="illegalPattern" value="true"/>
            <property name="message" value="❌ 禁止使用 System.out.println。✅ FIX: 使用 Lombok @Slf4j + log.info()/log.error()。📖 docs/conventions/naming.md"/>
        </module>

        <!-- 魔法数字 -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreAnnotation" value="true"/>
            <message key="magic.number" value="❌ 魔法数字。✅ FIX: 定义为命名常量 (private static final int)"/>
        </module>

        <!-- 可见性：成员变量应为 private -->
        <module name="VisibilityModifier">
            <property name="packageAllowed" value="false"/>
            <property name="protectedAllowed" value="false"/>
            <message key="variable.notPrivate" value="❌ 成员变量应为 private。✅ FIX: 添加 private 修饰符，通过 getter/setter 访问"/>
        </module>

        <!-- 确保 static 常量命名规范 -->
        <module name="ConstantNameCheck">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
    </module>
</module>
